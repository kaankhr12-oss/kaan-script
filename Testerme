local function skipCutscene()
    if not autoSkipEnabled then return end
    if POST then
        pcall(function() POST:FireServer("Cutscenes", "Skip") end)
        pcall(function() POST:FireServer("Cutscenes", "Finished") end)
    end
    local char = player.Character
    if char then char:SetAttribute("Cutscene", nil) end
end

local function clickGuiButton(btn)
    if not btn or not btn.Visible then return false end
    local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X/2
    local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y/2 + 45
    vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
    return true
end

local function openChests()
    if not autoFreeChest and not autoPremiumChest then return end
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    local interface = pg:FindFirstChild("Interface")
    if not interface then return end
    local chests = interface:FindFirstChild("Chests")
    if not chests or not chests.Visible then return end

    if autoFreeChest then
        local free = chests:FindFirstChild("Free")
        if free and free.Visible then clickGuiButton(free) task.wait(0.5) end
    end
    if autoPremiumChest then
        local premium = chests:FindFirstChild("Premium")
        if premium and premium.Visible then
            local title = premium:FindFirstChild("Title")
            if title and title:IsA("TextLabel") and not title.Text:find("(0)") then
                clickGuiButton(premium)
                task.wait(0.5)
            end
        end
    end
    task.wait(0.3)
    local finish = chests:FindFirstChild("Finish")
    if finish and finish.Visible then
        local freeStill = chests:FindFirstChild("Free")
        local premiumStill = chests:FindFirstChild("Premium")
        if (autoFreeChest and freeStill and freeStill.Visible) or (autoPremiumChest and premiumStill and premiumStill.Visible) then return end
        clickGuiButton(finish)
    end
end

task.spawn(function()
    while true do
        task.wait(2)
        pcall(function()
            if autoSkipEnabled then
                local char = player.Character
                if char and char:GetAttribute("Cutscene") == true then skipCutscene() end
                local pg = player:FindFirstChild("PlayerGui")
                if pg and pg:FindFirstChild("Interface") then
                    local int = pg.Interface
                    local skipBtn = int:FindFirstChild("Skip") or (int:FindFirstChild("Skip_Warning") and int.Skip_Warning:FindFirstChild("Yes"))
                    if skipBtn and skipBtn.Visible then clickGuiButton(skipBtn) end
                end
            end
            openChests()
        end)
    end
end)

task.spawn(function()
    while true do
        task.wait(3)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then
            globalRetry()
            task.wait(3)
        end
    end
end)


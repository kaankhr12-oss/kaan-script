(function()
    local player = game.Players.LocalPlayer
    local rs = game:GetService("ReplicatedStorage")
    local vi = game:GetService("VirtualInputManager")
    
    local assets = rs:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local POST = remotes and remotes:FindFirstChild("POST")
    local GET = remotes and remotes:FindFirstChild("GET")
    
    if not POST or not GET then return end
    
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    local attackEnabled = true
    local isReloading = false
    local isWaitingForRetry = false
    local titansKilled = 0
    local originalCFrame = nil
    local refillPosition = nil
    local refillPart = nil
    
    -- ========== GAS REFILL KESIN BUL ==========
    local function findGasRefill()
        print("[AOTR] Gas Refill aranıyor...")
        
        -- YOL 1: Climbable._Walls.Gate.GasTanks.Refill
        local climbable = workspace:FindFirstChild("Climbable")
        if climbable then
            local walls = climbable:FindFirstChild("_Walls")
            if walls then
                local gate = walls:FindFirstChild("Gate")
                if gate then
                    local gasTanks = gate:FindFirstChild("GasTanks")
                    if gasTanks then
                        local refill = gasTanks:FindFirstChild("Refill")
                        if refill and refill:IsA("BasePart") then
                            refillPart = refill
                            refillPosition = refill.Position
                            print("[AOTR] ✅ Gas Refill bulundu! Konum: " .. tostring(refillPosition))
                            return true
                        end
                    end
                end
            end
        end
        
        -- YOL 2: Tüm workspace'te Refill ara
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Refill" then
                refillPart = obj
                refillPosition = obj.Position
                print("[AOTR] ✅ Refill bulundu: " .. obj:GetFullName())
                return true
            end
        end
        
        -- YOL 3: GasTanks modeli içinde herhangi bir part
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "GasTanks" and obj:IsA("Model") then
                local anyPart = obj:FindFirstChildOfClass("BasePart")
                if anyPart then
                    refillPart = anyPart
                    refillPosition = anyPart.Position
                    print("[AOTR] ⚠️ GasTanks bulundu (Refill yok): " .. anyPart:GetFullName())
                    return true
                end
            end
        end
        
        print("[AOTR] ❌ Refill bulunamadı!")
        return false
    end
    
    -- ========== BIÇAK KIRIK MI ==========
    local function isBladeBroken()
        local rig = character:FindFirstChild("Rig_" .. player.Name)
        if rig then
            local leftHand = rig:FindFirstChild("LeftHand")
            if leftHand then
                local blade1 = leftHand:FindFirstChild("Blade_1")
                if blade1 and blade1.Transparency == 1 then
                    return true
                end
            end
            local rightHand = rig:FindFirstChild("RightHand")
            if rightHand then
                local blade2 = rightHand:FindFirstChild("Blade_2")
                if blade2 and blade2.Transparency == 1 then
                    return true
                end
            end
        end
        return false
    end
    
    -- ========== KESIN IŞINLANMA FONKSİYONU ==========
    local function teleportToPosition(pos)
        if not root then return false end
        local success, err = pcall(function()
            root.CFrame = CFrame.new(pos)
        end)
        if success then
            print("[AOTR] ✨ Işınlandı: " .. tostring(pos))
            return true
        else
            print("[AOTR] ❌ Işınlanma hatası: " .. tostring(err))
            return false
        end
    end
    
    -- ========== GAS REFILL'E IŞINLAN + R BAS ==========
    local function teleportToGasRefillAndReload()
        print("[AOTR] ═══════════════════════════════════════════")
        print("[AOTR] 🔴 GAS REFILL'E IŞINLANMA BAŞLATILIYOR!")
        
        -- Refill pozisyonu kontrol et
        if not refillPosition then
            if not findGasRefill() then
                print("[AOTR] ❌ Refill bulunamadı, iptal!")
                isReloading = false
                attackEnabled = true
                return false
            end
        end
        
        -- Orijinal pozisyonu kaydet
        originalCFrame = root.CFrame
        print("[AOTR] 📍 Orijinal pozisyon kaydedildi: " .. tostring(originalCFrame.Position))
        
        -- Işınlanma hedefi (Refill'in tam üstü)
        local targetPos = Vector3.new(
            refillPosition.X,
            refillPosition.Y + 3,
            refillPosition.Z
        )
        
        print("[AOTR] 🎯 Hedef konum: " .. tostring(targetPos))
        
        -- IŞINLAN (KESIN)
        task.wait(0.1)
        teleportToPosition(targetPos)
        task.wait(0.2)
        
        -- Biraz aşağı in (Refill'e dokunmak için)
        local groundPos = Vector3.new(refillPosition.X, refillPosition.Y + 1, refillPosition.Z)
        teleportToPosition(groundPos)
        task.wait(0.15)
        
        -- Konum kontrolü
        print("[AOTR] 📍 Şu anki konum: " .. tostring(root.Position))
        
        -- ========== R BAS (KESIN) ==========
        print("[AOTR] 🔫 REFILL NOKTASINDA R BASILIYOR!")
        
        -- Önce bir bekle
        task.wait(0.2)
        
        -- Dalga 1: Hızlı basımlar (10 kez)
        for i = 1, 10 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.03)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.02)
            end)
        end
        
        -- Dalga 2: Uzun basımlar (5 kez)
        for i = 1, 5 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.15)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.05)
            end)
        end
        
        -- Dalga 3: Basılı tut
        pcall(function()
            vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.5)
            vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)
        
        print("[AOTR] ✅ R basımı tamamlandı (15+ kez)")
        
        task.wait(0.5)
        
        -- Orijinal pozisyona geri dön
        if originalCFrame then
            print("[AOTR] 🔄 Orijinal pozisyona dönülüyor...")
            teleportToPosition(originalCFrame.Position)
        end
        
        task.wait(0.3)
        
        print("[AOTR] ✅ GAS REFILL RELOAD TAMAMLANDI!")
        print("[AOTR] ═══════════════════════════════════════════")
        
        isReloading = false
        attackEnabled = true
        return true
    end
    
    -- ========== NORMAL RELOAD ==========
    local function doNormalReload()
        if isReloading then return false end
        isReloading = true
        attackEnabled = false
        
        print("[AOTR] 🔫 Normal reload başladı (5 kez R)...")
        
        for i = 1, 5 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.05)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.05)
            end)
        end
        
        print("[AOTR] ⏳ 4 saniye bekleniyor...")
        task.wait(4)
        
        -- 4 saniye sonra kontrol
        if isBladeBroken() then
            print("[AOTR] ⚠️ 4 saniyede reload olmadı! Gas Refill'e gidiliyor...")
            teleportToGasRefillAndReload()
        else
            print("[AOTR] ✅ Reload başarılı!")
            isReloading = false
            attackEnabled = true
        end
        
        return true
    end
    
    -- ========== BIÇAK MONİTÖRÜ ==========
    local function startBladeMonitor()
        task.spawn(function()
            while true do
                task.wait(0.3)
                if attackEnabled and not isReloading and not isWaitingForRetry then
                    if isBladeBroken() then
                        print("[AOTR] ⚠️ Bıçak kırıldı!")
                        doNormalReload()
                    end
                end
            end
        end)
    end
    
    -- ========== TİTANLARI BUL ==========
    local function getAllTitans()
        local list = {}
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return list end
        
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local h = t:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local hb = t:FindFirstChild("Hitboxes")
                    if hb then
                        local hit = hb:FindFirstChild("Hit")
                        if hit then
                            local nape = hit:FindFirstChild("Nape")
                            if nape then
                                table.insert(list, {
                                    titan = t,
                                    nape = nape,
                                    name = t.Name,
                                    pos = nape.Position
                                })
                            end
                        end
                    end
                end
            end
        end
        return list
    end
    
    -- ========== VURUŞ ==========
    local function hitTitan(nape, pos)
        if not attackEnabled or isReloading or isWaitingForRetry then return end
        
        -- Nape'e ışınlan
        pcall(function()
            root.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
        end)
        task.wait(0.002)
        
        -- M1 bas
        pcall(function()
            vi:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        end)
        task.wait(0.002)
        pcall(function()
            vi:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
        
        -- Geri dön
        if originalCFrame then
            pcall(function()
                root.CFrame = originalCFrame
            end)
        end
        
        -- Hasar gönder
        pcall(function()
            POST:FireServer("Attacks", "Slash", true)
        end)
        task.wait(0.001)
        pcall(function()
            GET:InvokeServer("Hitboxes", "Register", nape, 999999, 999999)
        end)
    end
    
    -- ========== TİTAN TEMİZLE ==========
    local function clearTitans()
        if isReloading or isWaitingForRetry then return end
        
        local titans = getAllTitans()
        if #titans == 0 then
            isWaitingForRetry = true
            return
        end
        
        for _, tData in pairs(titans) do
            if attackEnabled and not isReloading and not isWaitingForRetry then
                hitTitan(tData.nape, tData.pos)
                titansKilled = titansKilled + 1
                task.wait(0.008)
            end
        end
    end
    
    -- ========== RETRY ==========
    local function doRetry()
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local interface = playerGui:FindFirstChild("Interface")
            if interface then
                local rewards = interface:FindFirstChild("Rewards")
                if rewards then
                    local main = rewards:FindFirstChild("Main")
                    if main then
                        local info = main:FindFirstChild("Info")
                        if info then
                            local mainInfo = info:FindFirstChild("Main")
                            if mainInfo then
                                local buttons = mainInfo:FindFirstChild("Buttons")
                                if buttons then
                                    local retry = buttons:FindFirstChild("Retry")
                                    if retry then
                                        local title = retry:FindFirstChild("Title")
                                        if title then
                                            pcall(function()
                                                local x = title.AbsolutePosition.X + title.AbsoluteSize.X / 2
                                                local y = title.AbsolutePosition.Y + title.AbsoluteSize.Y / 2 + 45
                                                vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                                task.wait(0.05)
                                                vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(2)
    end
    
    -- ========== ANA DÖNGÜ ==========
    local function mainLoop()
        task.spawn(function()
            while true do
                titansKilled = 0
                isWaitingForRetry = false
                attackEnabled = true
                
                originalCFrame = root.CFrame
                print("[AOTR] 🎯 Ana döngü başladı!")
                
                while true do
                    if #getAllTitans() == 0 then
                        print("[AOTR] 🏆 Tüm titanlar temizlendi!")
                        break
                    end
                    clearTitans()
                    task.wait(0.05)
                end
                
                print("[AOTR] 🔄 Retry yapılıyor...")
                isWaitingForRetry = true
                attackEnabled = false
                doRetry()
                isWaitingForRetry = false
                attackEnabled = true
                task.wait(0.5)
            end
        end)
    end
    
    -- ========== NAPE GENİŞLET ==========
    local function extendNape()
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return end
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local hb = t:FindFirstChild("Hitboxes")
                if hb then
                    local hit = hb:FindFirstChild("Hit")
                    if hit then
                        local nape = hit:FindFirstChild("Nape")
                        if nape then
                            nape.Size = Vector3.new(150, 120, 150)
                            nape.Transparency = 0.2
                        end
                    end
                end
            end
        end
    end
    
    -- ========== BAŞLAT ==========
    findGasRefill()
    extendNape()
    startBladeMonitor()
    mainLoop()
    
    print("═══════════════════════════════════════════════════════════")
    print("     KESIN IŞINLANMA + GAS REFILL RELOAD v11.0")
    print("═══════════════════════════════════════════════════════════")
    print("✅ Bıçak kırılınca → Normal R bas (5 kez)")
    print("✅ 4 saniye bekle")
    print("✅ Hala kırıksa → KESIN IŞINLANMA (pcall ile)")
    print("✅ Gas Refill'de 15+ kez R bas")
    print("✅ Orijinal konuma geri dön")
    print("═══════════════════════════════════════════════════════════")
    
    if refillPosition then
        print("🎯 REFILL KONUMU: " .. tostring(refillPosition))
        print("✅ Işınlanma HAZIR!")
    else
        print("❌ REFILL BULUNAMADI! Lütfen manuel konum girin")
    end
    
    print = function() end
    warn = function() end
end)()

(function()
    local player = game.Players.LocalPlayer
    local rs = game:GetService("ReplicatedStorage")
    local vi = game:GetService("VirtualInputManager")
    
    local assets = rs:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local POST = remotes and remotes:FindFirstChild("POST")
    local GET = remotes and remotes:FindFirstChild("GET")
    
    if not POST or not GET then return end
    
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    local attackEnabled = true
    local isReloading = false
    local isWaitingForRetry = false
    local titansKilled = 0
    local originalCFrame = nil
    local refillPosition = nil
    local refillPart = nil
    
    -- RELOAD TAKİBİ İÇİN
    local lastReloadTime = 0
    local reloadCounter = 0
    local noReloadStartTime = nil
    local isMonitoringNoReload = false
    
    -- ========== AUTO ESCAPE ==========
    local function setupAutoEscape()
        local function clickEscapeButton()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui then
                local interface = playerGui:FindFirstChild("Interface")
                if interface then
                    local buttons = interface:FindFirstChild("Buttons")
                    if buttons then
                        for _, btn in pairs(buttons:GetChildren()) do
                            if btn:IsA("ImageButton") or btn:IsA("TextButton") then
                                local btnName = btn.Name:lower()
                                if btnName:find("escape") or btnName:find("exit") or btnName:find("leave") or btnName:find("quit") then
                                    pcall(function()
                                        local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                                        local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
                                        vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                        task.wait(0.05)
                                        vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
        
        local function slashEscape()
            pcall(function()
                POST:FireServer("Attacks", "Slash_Escape")
            end)
        end
        
        local function monitorEscapeButton()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui then
                local interface = playerGui:FindFirstChild("Interface")
                if interface then
                    local buttons = interface:FindFirstChild("Buttons")
                    if buttons then
                        buttons.ChildAdded:Connect(function(btn)
                            task.wait(0.05)
                            local btnName = btn.Name:lower()
                            if btnName:find("escape") or btnName:find("exit") or btnName:find("leave") or btnName:find("quit") then
                                pcall(function()
                                    local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                                    local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
                                    vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                    task.wait(0.05)
                                    vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                                end)
                                slashEscape()
                                task.wait(0.1)
                                btn:Destroy()
                            end
                        end)
                    end
                end
            end
        end
        
        local function autoEscapeWhenGrabbed()
            task.spawn(function()
                while true do
                    task.wait(0.2)
                    if attackEnabled and not isReloading and not isWaitingForRetry then
                        local humanoidRoot = character:FindFirstChild("HumanoidRootPart")
                        if humanoidRoot then
                            local grabAttachments = humanoidRoot:FindFirstChild("GrabAttach")
                            if grabAttachments then
                                slashEscape()
                                clickEscapeButton()
                                task.wait(0.1)
                                slashEscape()
                            end
                        end
                    end
                end
            end)
        end
        
        monitorEscapeButton()
        autoEscapeWhenGrabbed()
    end
    
    -- ========== GAS REFILL BUL ==========
    local function findGasRefill()
        local climbable = workspace:FindFirstChild("Climbable")
        if climbable then
            local walls = climbable:FindFirstChild("_Walls")
            if walls then
                local gate = walls:FindFirstChild("Gate")
                if gate then
                    local gasTanks = gate:FindFirstChild("GasTanks")
                    if gasTanks then
                        local refill = gasTanks:FindFirstChild("Refill")
                        if refill and refill:IsA("BasePart") then
                            refillPart = refill
                            refillPosition = refill.Position
                            return true
                        end
                    end
                end
            end
        end
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Refill" then
                refillPart = obj
                refillPosition = obj.Position
                return true
            end
        end
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "GasTanks" and obj:IsA("Model") then
                local anyPart = obj:FindFirstChildOfClass("BasePart")
                if anyPart then
                    refillPart = anyPart
                    refillPosition = anyPart.Position
                    return true
                end
            end
        end
        
        return false
    end
    
    -- ========== BIÇAK KIRIK MI ==========
    local function isBladeBroken()
        local rig = character:FindFirstChild("Rig_" .. player.Name)
        if rig then
            local leftHand = rig:FindFirstChild("LeftHand")
            if leftHand then
                local blade1 = leftHand:FindFirstChild("Blade_1")
                if blade1 and blade1.Transparency == 1 then
                    return true
                end
            end
            local rightHand = rig:FindFirstChild("RightHand")
            if rightHand then
                local blade2 = rightHand:FindFirstChild("Blade_2")
                if blade2 and blade2.Transparency == 1 then
                    return true
                end
            end
        end
        return false
    end
    
    -- ========== RELOAD YAP ==========
    local function doReload()
        if isReloading then return false end
        isReloading = true
        attackEnabled = false
        
        -- Reload zamanını güncelle
        lastReloadTime = tick()
        reloadCounter = reloadCounter + 1
        
        -- 10 saniye reload yoksa kontrolünü sıfırla
        noReloadStartTime = nil
        isMonitoringNoReload = false
        
        print("[AOTR] 🔫 Reload yapılıyor... (Toplam reload sayısı: " .. reloadCounter .. ")")
        
        for i = 1, 6 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.05)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.05)
            end)
        end
        
        task.wait(1.5)
        
        isReloading = false
        attackEnabled = true
        
        print("[AOTR] ✅ Reload tamamlandı!")
        return true
    end
    
    -- ========== 10 SANİYE RELOAD YOKSA GAS REFILL'E GİT ==========
    local function startNoReloadMonitor()
        task.spawn(function()
            while true do
                task.wait(1) -- Her saniye kontrol et
                
                -- Sadece attackEnabled ve reload yapmıyorken kontrol et
                if attackEnabled and not isReloading and not isWaitingForRetry then
                    
                    -- Eğer 10 saniye reload yapılmadıysa ve bıçak kırıksa
                    local timeSinceLastReload = tick() - lastReloadTime
                    
                    if timeSinceLastReload >= 10 and isBladeBroken() then
                        print("[AOTR] ⚠️ 10 saniyedir reload yapılmadı VE bıçak kırık!")
                        print("[AOTR] 🏃 Gas Refill'e gidiliyor...")
                        
                        -- Gas Refill'e git
                        if not refillPosition then
                            findGasRefill()
                        end
                        
                        if refillPosition then
                            -- Orijinal pozisyonu kaydet
                            originalCFrame = root.CFrame
                            
                            -- Refill'e ışınlan
                            local targetPos = Vector3.new(refillPosition.X, refillPosition.Y + 3, refillPosition.Z)
                            pcall(function()
                                root.CFrame = CFrame.new(targetPos)
                            end)
                            task.wait(0.2)
                            
                            -- Yere in
                            local groundPos = Vector3.new(refillPosition.X, refillPosition.Y + 1, refillPosition.Z)
                            pcall(function()
                                root.CFrame = CFrame.new(groundPos)
                            end)
                            task.wait(0.15)
                            
                            print("[AOTR] 🔫 Gas Refill'de R basılıyor...")
                            
                            -- R bas (15+ kez)
                            for i = 1, 15 do
                                pcall(function()
                                    vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                    task.wait(0.03)
                                    vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                                    task.wait(0.02)
                                end)
                            end
                            
                            -- Uzun bas
                            pcall(function()
                                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                task.wait(0.5)
                                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                            end)
                            
                            task.wait(0.5)
                            
                            -- Orijinal pozisyona dön
                            if originalCFrame then
                                pcall(function()
                                    root.CFrame = originalCFrame
                                end)
                            end
                            
                            -- Reload zamanını güncelle
                            lastReloadTime = tick()
                            
                            print("[AOTR] ✅ Gas Refill reload tamamlandı!")
                        else
                            print("[AOTR] ❌ Gas Refill bulunamadı!")
                        end
                    end
                end
            end
        end)
    end
    
    -- ========== TİTANLARI BUL ==========
    local function getAllTitans()
        local list = {}
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return list end
        
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local h = t:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local hb = t:FindFirstChild("Hitboxes")
                    if hb then
                        local hit = hb:FindFirstChild("Hit")
                        if hit then
                            local nape = hit:FindFirstChild("Nape")
                            if nape then
                                table.insert(list, {
                                    titan = t,
                                    nape = nape,
                                    name = t.Name,
                                    pos = nape.Position
                                })
                            end
                        end
                    end
                end
            end
        end
        return list
    end
    
    -- ========== HIZLI VURUŞ ==========
    local function fastHit(nape, pos)
        if not attackEnabled or isReloading or isWaitingForRetry then return end
        
        pcall(function()
            root.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
        end)
        task.wait(0.002)
        
        pcall(function()
            vi:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        end)
        task.wait(0.002)
        pcall(function()
            vi:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
        
        if originalCFrame then
            pcall(function()
                root.CFrame = originalCFrame
            end)
        end
        
        pcall(function()
            POST:FireServer("Attacks", "Slash", true)
        end)
        task.wait(0.001)
        pcall(function()
            GET:InvokeServer("Hitboxes", "Register", nape, 999999, 999999)
        end)
    end
    
    -- ========== TİTAN TEMİZLE ==========
    local function clearTitans()
        if isReloading or isWaitingForRetry then return end
        
        local titans = getAllTitans()
        if #titans == 0 then
            isWaitingForRetry = true
            return
        end
        
        for _, tData in pairs(titans) do
            if attackEnabled and not isReloading and not isWaitingForRetry then
                fastHit(tData.nape, tData.pos)
                titansKilled = titansKilled + 1
                task.wait(0.008)
            end
        end
    end
    
    -- ========== RETRY ==========
    local function doRetry()
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local interface = playerGui:FindFirstChild("Interface")
            if interface then
                local rewards = interface:FindFirstChild("Rewards")
                if rewards then
                    local main = rewards:FindFirstChild("Main")
                    if main then
                        local info = main:FindFirstChild("Info")
                        if info then
                            local mainInfo = info:FindFirstChild("Main")
                            if mainInfo then
                                local buttons = mainInfo:FindFirstChild("Buttons")
                                if buttons then
                                    local retry = buttons:FindFirstChild("Retry")
                                    if retry then
                                        local title = retry:FindFirstChild("Title")
                                        if title then
                                            pcall(function()
                                                local x = title.AbsolutePosition.X + title.AbsoluteSize.X / 2
                                                local y = title.AbsolutePosition.Y + title.AbsoluteSize.Y / 2 + 45
                                                vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                                task.wait(0.05)
                                                vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(2)
    end
    
    -- ========== ANA DÖNGÜ ==========
    local function mainLoop()
        task.spawn(function()
            while true do
                titansKilled = 0
                isWaitingForRetry = false
                attackEnabled = true
                
                originalCFrame = root.CFrame
                lastReloadTime = tick() -- Başlangıç reload zamanı
                
                print("[AOTR] 🎯 Ana döngü başladı!")
                
                while true do
                    if #getAllTitans() == 0 then
                        print("[AOTR] 🏆 Tüm titanlar temizlendi!")
                        break
                    end
                    clearTitans()
                    task.wait(0.05)
                end
                
                print("[AOTR] 🔄 Retry yapılıyor...")
                isWaitingForRetry = true
                attackEnabled = false
                doRetry()
                isWaitingForRetry = false
                attackEnabled = true
                task.wait(0.5)
            end
        end)
    end
    
    -- ========== BIÇAK DURUMU GÖSTERGESİ ==========
    local function bladeStatusIndicator()
        task.spawn(function()
            while true do
                task.wait(5) -- Her 5 saniyede bir göster
                if attackEnabled and not isReloading then
                    local broken = isBladeBroken()
                    local timeSinceReload = tick() - lastReloadTime
                    if broken then
                        print("[AOTR] 🗡️ BIÇAK DURUMU: KIRIK | Son reload: " .. math.floor(timeSinceReload) .. " saniye önce")
                        if timeSinceReload >= 10 then
                            print("[AOTR] ⚠️ 10 saniye doldu! Yakında Refill'e gidilecek...")
                        end
                    else
                        print("[AOTR] 🗡️ BIÇAK DURUMU: SAĞLAM | Son reload: " .. math.floor(timeSinceReload) .. " saniye önce")
                    end
                end
            end
        end)
    end
    
    -- ========== NAPE GENİŞLET ==========
    local function extendNape()
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return end
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local hb = t:FindFirstChild("Hitboxes")
                if hb then
                    local hit = hb:FindFirstChild("Hit")
                    if hit then
                        local nape = hit:FindFirstChild("Nape")
                        if nape then
                            nape.Size = Vector3.new(150, 120, 150)
                            nape.Transparency = 0.2
                        end
                    end
                end
            end
        end
    end
    
    -- ========== BAŞLAT ==========
    findGasRefill()
    extendNape()
    setupAutoEscape()
    startNoReloadMonitor()  -- 10 saniye reload yoksa kontrol et
    bladeStatusIndicator()   -- Durum göstergesi
    mainLoop()
    
    print("═══════════════════════════════════════════════════════════")
    print("    10 SANİYE RELOAD YOKSA GAS REFILL'E GİT v13.0")
    print("═══════════════════════════════════════════════════════════")
    print("⏱️ KURAL: 10 saniye boyunca reload YAPILMAZSA ve bıçak KIRIKSA")
    print("🎯 SONUÇ: Otomatik olarak Gas Refill'e gidip reload yapar")
    print("")
    print("🔄 NORMAL RELOAD:")
    print("   • Bıçak kırılınca hemen reload yapar")
    print("   • Reload zamanını kaydeder")
    print("")
    print("⏰ 10 SANİYE MONİTÖRÜ:")
    print("   • Her saniye kontrol eder")
    print("   • 10 saniye reload yoksa + bıçak kırıksa → REFILL'E GİT")
    print("   • Refill'de 15+ kez R bas → Geri dön")
    print("═══════════════════════════════════════════════════════════")
    
    if refillPosition then
        print("🎯 GAS REFILL KONUMU: " .. tostring(refillPosition))
    end
    print("✅ Sistem HAZIR! Bıçak kırılırsa reload yapar, 10 saniye reload yoksa Refill'e gider!")
    
    print = function() end
    warn = function() end
end)()

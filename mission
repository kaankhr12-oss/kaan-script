(function()
    local player = game.Players.LocalPlayer
    local rs = game:GetService("ReplicatedStorage")
    local vi = game:GetService("VirtualInputManager")
    local runService = game:GetService("RunService")
    local lighting = game:GetService("Lighting")
    local workspace = game:GetService("Workspace")
    
    -- ========== FPS BOOST ==========
    local function fpsBoost()
        pcall(function()
            lighting.GlobalShadows = false
            lighting.FogEnd = 1000
            lighting.FogStart = 500
            lighting.Brightness = 1
            lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)
            lighting.Ambient = Color3.fromRGB(80, 80, 80)
            
            settings().Rendering.QualityLevel = 1
            settings().Rendering.EffectsQuality = 1
            
            for _, part in pairs(workspace:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CastShadow = false
                end
                if part:IsA("ParticleEmitter") then
                    part.Enabled = false
                    part.Rate = 0
                end
            end
        end)
    end
    
    -- ========== MEMORY TEMİZLİĞİ ==========
    task.spawn(function()
        while true do
            task.wait(30)
            collectgarbage("collect")
        end
    end)
    
    fpsBoost()
    
    -- ========== ANA SİSTEM ==========
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    local assets = rs:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local POST = remotes and remotes:FindFirstChild("POST")
    local GET = remotes and remotes:FindFirstChild("GET")
    
    if not POST or not GET then return end
    
    -- ========== DEĞİŞKENLER ==========
    local attackEnabled = true
    local isReloading = false
    local isWaitingForRetry = false
    local titansKilled = 0
    local originalCFrame = nil
    local refillPosition = nil
    local currentRoundTitans = 0
    local isRoundFinished = false
    
    -- ========== GAS REFILL BUL ==========
    local function findGasRefill()
        local climbable = workspace:FindFirstChild("Climbable")
        if climbable then
            local walls = climbable:FindFirstChild("_Walls")
            if walls then
                local gate = walls:FindFirstChild("Gate")
                if gate then
                    local gasTanks = gate:FindFirstChild("GasTanks")
                    if gasTanks then
                        local refill = gasTanks:FindFirstChild("Refill")
                        if refill and refill:IsA("BasePart") then
                            refillPosition = refill.Position
                            print("[AOTR] ✅ Gas Refill bulundu!")
                            return true
                        end
                    end
                end
            end
        end
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Refill" then
                refillPosition = obj.Position
                print("[AOTR] ✅ Refill bulundu!")
                return true
            end
        end
        return false
    end
    
    findGasRefill()
    
    -- ========== AUTO ESCAPE ==========
    local function setupAutoEscape()
        local function slashEscape()
            pcall(function() POST:FireServer("Attacks", "Slash_Escape") end)
        end
        
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local interface = playerGui:FindFirstChild("Interface")
            if interface then
                local buttons = interface:FindFirstChild("Buttons")
                if buttons then
                    buttons.ChildAdded:Connect(function(btn)
                        task.wait(0.05)
                        local btnName = btn.Name:lower()
                        if btnName:find("escape") or btnName:find("exit") then
                            pcall(function()
                                local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
                                local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
                                vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                task.wait(0.05)
                                vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                            end)
                            slashEscape()
                            btn:Destroy()
                        end
                    end)
                end
            end
        end
    end
    
    setupAutoEscape()
    
    -- ========== CANLI TİTAN SAYISI (KESİN) ==========
    local function getAliveTitanCount()
        local count = 0
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return 0 end
        
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local h = t:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    count = count + 1
                end
            end
        end
        return count
    end
    
    -- ========== TÜM CANLI TİTANLARI GETİR ==========
    local function getAliveTitans()
        local list = {}
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return list end
        
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local h = t:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local hb = t:FindFirstChild("Hitboxes")
                    if hb then
                        local hit = hb:FindFirstChild("Hit")
                        if hit then
                            local nape = hit:FindFirstChild("Nape")
                            if nape then
                                table.insert(list, {
                                    titan = t,
                                    nape = nape,
                                    humanoid = h,
                                    pos = nape.Position
                                })
                            end
                        end
                    end
                end
            end
        end
        return list
    end
    
    -- ========== BIÇAK KIRIK MI ==========
    local function isBladeBroken()
        local rig = character:FindFirstChild("Rig_" .. player.Name)
        if rig then
            local leftHand = rig:FindFirstChild("LeftHand")
            if leftHand then
                local blade1 = leftHand:FindFirstChild("Blade_1")
                if blade1 and blade1.Transparency == 1 then
                    return true
                end
            end
            local rightHand = rig:FindFirstChild("RightHand")
            if rightHand then
                local blade2 = rightHand:FindFirstChild("Blade_2")
                if blade2 and blade2.Transparency == 1 then
                    return true
                end
            end
        end
        return false
    end
    
    -- ========== IŞINLANMA ==========
    local function teleportToPosition(pos)
        pcall(function() root.CFrame = CFrame.new(pos) end)
    end
    
    -- ========== REFILL'E IŞINLAN + R BAS ==========
    local function teleportToGasRefillAndReload()
        if not refillPosition then
            if not findGasRefill() then
                isReloading = false
                attackEnabled = true
                return
            end
        end
        
        originalCFrame = root.CFrame
        
        local targetPos = Vector3.new(refillPosition.X, refillPosition.Y + 3, refillPosition.Z)
        teleportToPosition(targetPos)
        task.wait(0.15)
        
        local groundPos = Vector3.new(refillPosition.X, refillPosition.Y + 1, refillPosition.Z)
        teleportToPosition(groundPos)
        task.wait(0.1)
        
        for i = 1, 12 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.03)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.02)
            end)
        end
        
        task.wait(0.3)
        
        if originalCFrame then
            teleportToPosition(originalCFrame.Position)
        end
        
        isReloading = false
        attackEnabled = true
    end
    
    -- ========== NORMAL RELOAD ==========
    local function doNormalReload()
        if isReloading then return end
        isReloading = true
        attackEnabled = false
        
        for i = 1, 5 do
            pcall(function()
                vi:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                task.wait(0.05)
                vi:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                task.wait(0.05)
            end)
        end
        
        task.wait(4)
        
        if isBladeBroken() then
            teleportToGasRefillAndReload()
        else
            isReloading = false
            attackEnabled = true
        end
    end
    
    -- ========== BIÇAK MONİTÖRÜ ==========
    task.spawn(function()
        while true do
            task.wait(0.3)
            if attackEnabled and not isReloading and not isWaitingForRetry then
                if isBladeBroken() then
                    doNormalReload()
                end
            end
        end
    end)
    
    -- ========== TİTAN ÖLÜNCE VURMAYI DURDUR (EN ÖNEMLİ KISIM) ==========
    local currentTitanCount = 0
    
    -- Titan ölümünü izle
    local function monitorTitanDeath()
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return end
        
        -- Mevcut titanları izle
        for _, titan in pairs(tf:GetChildren()) do
            if titan:IsA("Model") then
                local humanoid = titan:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    -- Titan öldüğünde tetiklenecek
                    local deathConn
                    deathConn = humanoid.Died:Connect(function()
                        print("[AOTR] 💀 Bir titan öldü! Kalan titan: " .. getAliveTitanCount())
                        task.wait(0.1)
                        -- Eğer hiç titan kalmadıysa vurmayı durdur
                        if getAliveTitanCount() == 0 then
                            print("[AOTR] 🏆 HİÇ TİTAN KALMADI! VURMA DURDURULDU!")
                            isWaitingForRetry = true
                            attackEnabled = false
                        end
                        deathConn:Disconnect()
                    end)
                end
            end
        end
    end
    
    -- Yeni titan eklendiğinde izleme başlat
    local function startTitanMonitoring()
        local tf = workspace:FindFirstChild("Titans")
        if tf then
            -- Mevcut titanları izle
            monitorTitanDeath()
            
            -- Yeni eklenen titanları izle
            tf.ChildAdded:Connect(function(newTitan)
                task.wait(0.1)
                local humanoid = newTitan:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.Died:Connect(function()
                        print("[AOTR] 💀 Bir titan öldü! Kalan titan: " .. getAliveTitanCount())
                        task.wait(0.1)
                        if getAliveTitanCount() == 0 then
                            print("[AOTR] 🏆 HİÇ TİTAN KALMADI! VURMA DURDURULDU!")
                            isWaitingForRetry = true
                            attackEnabled = false
                        end
                    end)
                end
            end)
        end
    end
    
    -- ========== TİTANLARI VUR (SADECE CANLI OLANLARI) ==========
    local function hitTitan(nape, pos)
        if not attackEnabled or isReloading or isWaitingForRetry then return false end
        
        -- Tekrar kontrol: Vurmadan önce hala titan var mı?
        if getAliveTitanCount() == 0 then
            print("[AOTR] ⏸️ Vuruş engellendi: Titan kalmadı!")
            isWaitingForRetry = true
            attackEnabled = false
            return false
        end
        
        pcall(function() root.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
        task.wait(0.002)
        
        pcall(function() vi:SendMouseButtonEvent(0, 0, 0, true, game, 0) end)
        task.wait(0.002)
        pcall(function() vi:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
        
        if originalCFrame then
            pcall(function() root.CFrame = originalCFrame end)
        end
        
        pcall(function() POST:FireServer("Attacks", "Slash", true) end)
        task.wait(0.001)
        pcall(function() GET:InvokeServer("Hitboxes", "Register", nape, 999999, 999999) end)
        
        return true
    end
    
    -- ========== TİTAN TEMİZLEME DÖNGÜSÜ ==========
    local function clearTitans()
        if isReloading or isWaitingForRetry then return end
        
        -- Önce canlı titan sayısını kontrol et
        local aliveCount = getAliveTitanCount()
        if aliveCount == 0 then
            if not isWaitingForRetry then
                print("[AOTR] 🏆 Tüm titanlar öldü! Bekleme moduna geçiliyor...")
                isWaitingForRetry = true
                attackEnabled = false
            end
            return
        end
        
        local titans = getAliveTitans()
        if #titans == 0 then
            isWaitingForRetry = true
            attackEnabled = false
            return
        end
        
        for _, tData in pairs(titans) do
            if attackEnabled and not isReloading and not isWaitingForRetry then
                -- Vurmadan önce tekrar kontrol et (titan bu sırada ölmüş olabilir)
                if tData.humanoid and tData.humanoid.Health > 0 then
                    hitTitan(tData.nape, tData.pos)
                    titansKilled = titansKilled + 1
                end
                task.wait(0.008)
            end
        end
    end
    
    -- ========== RETRY ==========
    local function doRetry()
        print("[AOTR] 🔄 Retry başlatılıyor...")
        
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            local interface = playerGui:FindFirstChild("Interface")
            if interface then
                local rewards = interface:FindFirstChild("Rewards")
                if rewards then
                    local main = rewards:FindFirstChild("Main")
                    if main then
                        local info = main:FindFirstChild("Info")
                        if info then
                            local mainInfo = info:FindFirstChild("Main")
                            if mainInfo then
                                local buttons = mainInfo:FindFirstChild("Buttons")
                                if buttons then
                                    local retry = buttons:FindFirstChild("Retry")
                                    if retry then
                                        local title = retry:FindFirstChild("Title")
                                        if title then
                                            pcall(function()
                                                local x = title.AbsolutePosition.X + title.AbsoluteSize.X / 2
                                                local y = title.AbsolutePosition.Y + title.AbsoluteSize.Y / 2 + 45
                                                vi:SendMouseButtonEvent(x, y, 0, true, game, 0)
                                                task.wait(0.05)
                                                vi:SendMouseButtonEvent(x, y, 0, false, game, 0)
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        
        task.wait(2)
        
        -- Retry sonrası sıfırla
        isWaitingForRetry = false
        attackEnabled = true
        titansKilled = 0
        originalCFrame = root.CFrame
        
        print("[AOTR] ✅ Retry tamamlandı! Yeniden başlıyor...")
    end
    
    -- ========== ANA DÖNGÜ ==========
    local function mainLoop()
        task.spawn(function()
            while true do
                -- Bekleme modunda bekle
                while isWaitingForRetry do
                    task.wait(0.5)
                    -- Retry butonu çıktı mı kontrol et
                    local playerGui = player:FindFirstChild("PlayerGui")
                    if playerGui then
                        local interface = playerGui:FindFirstChild("Interface")
                        if interface then
                            local rewards = interface:FindFirstChild("Rewards")
                            if rewards then
                                local main = rewards:FindFirstChild("Main")
                                if main then
                                    local info = main:FindFirstChild("Info")
                                    if info then
                                        local mainInfo = info:FindFirstChild("Main")
                                        if mainInfo then
                                            local buttons = mainInfo:FindFirstChild("Buttons")
                                            if buttons and buttons:FindFirstChild("Retry") then
                                                print("[AOTR] 🎯 Retry butonu bulundu! Retry yapılıyor...")
                                                doRetry()
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                
                -- Normal döngü
                titansKilled = 0
                isWaitingForRetry = false
                attackEnabled = true
                originalCFrame = root.CFrame
                
                print("[AOTR] 🎯 Ana döngü başladı! Canlı titan: " .. getAliveTitanCount())
                
                -- Titanlar bitene kadar vur
                while getAliveTitanCount() > 0 and not isWaitingForRetry do
                    clearTitans()
                    task.wait(0.05)
                end
                
                if not isWaitingForRetry then
                    print("[AOTR] 🏆 Tüm titanlar temizlendi! Retry bekleniyor...")
                    isWaitingForRetry = true
                    attackEnabled = false
                end
                
                task.wait(0.5)
            end
        end)
    end
    
    -- ========== NAPE GENİŞLET ==========
    local function extendNape()
        local tf = workspace:FindFirstChild("Titans")
        if not tf then return end
        for _, t in pairs(tf:GetChildren()) do
            if t:IsA("Model") then
                local hb = t:FindFirstChild("Hitboxes")
                if hb then
                    local hit = hb:FindFirstChild("Hit")
                    if hit then
                        local nape = hit:FindFirstChild("Nape")
                        if nape then
                            nape.Size = Vector3.new(150, 120, 150)
                            nape.Transparency = 0.2
                        end
                    end
                end
            end
        end
    end
    
    -- ========== BAŞLAT ==========
    extendNape()
    startTitanMonitoring()
    mainLoop()
    
    -- Yeni titan eklendiğinde nape genişlet
    local tf = workspace:FindFirstChild("Titans")
    if tf then
        tf.ChildAdded:Connect(function()
            task.wait(0.1)
            extendNape()
        end)
    end
    
    -- Karakter hızı
    pcall(function()
        if humanoid then
            humanoid.WalkSpeed = 100
            humanoid.JumpPower = 80
        end
    end)
    
    print("═══════════════════════════════════════════════════════════")
    print("     TİTAN ÖLÜNCE VURMAYI DURDUR + FPS BOOST v14.0")
    print("═══════════════════════════════════════════════════════════")
    print("✅ TİTAN ÖLÜNCE TESPİT (Humanoid.Died event)")
    print("✅ HİÇ TİTAN KALMAYINCA VURMA DURUR")
    print("✅ Retry butonu çıkınca OTOMATIK RETRY")
    print("✅ Bıçak kırılınca 4 sn bekle → Refill'e ışınlan")
    print("✅ FPS BOOST + Memory Cleanup Aktif")
    print("═══════════════════════════════════════════════════════════")
    
    print = function() end
    warn = function() end
end)()
